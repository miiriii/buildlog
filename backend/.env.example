# 이 파일을 backend/.env로 복사한 뒤 실제 값은 .env에만 입력하세요.
# 기존 프로젝트에서는 backend/.env를 준비했으며 SECRET_KEY를 유지했습니다.
APP_ENV=development

# Supabase 프로젝트의 Connect -> Session pooler -> URI를 입력하세요.
# 포트: 5432 (Transaction pooler의 6543이 아닙니다.)
# Host/User/Database는 화면에 표시된 값을 그대로 사용하세요.
# Password는 프로젝트의 DB 비밀번호이며 anon/service_role API 키가 아닙니다.
# URI에 넣는 비밀번호의 @ : / # % 등 특수문자는 URL 인코딩해야 합니다.
# 연결 문자열 끝에 ?sslmode=require를 붙이세요. 기본 연결도 SSL을 요구합니다.
# DATABASE_URL은 필수입니다. 비워두거나 잘못 입력하면 SQLite로 대체하지 않습니다.
# 비밀번호와 전체 URI를 채팅, 코드, 로그에 붙여 넣지 마세요.
DATABASE_URL=

# 32자 이상의 무작위 서버 비밀값. 기존 backend/.env의 값은 유지하세요.
# 새 환경에서는 비밀값을 생성해 이 예제가 아닌 .env에만 저장하세요.
SECRET_KEY=
CORS_ORIGINS=["http://localhost:5173"]
SESSION_COOKIE_NAME=buildlog_session
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_SECURE=false

# 학습 자료함 자동 요약: 실제 키는 backend/.env에만 추가하세요.
# 키가 없거나 잘못돼도 원본 저장은 유지됩니다. 새 자료부터 자동 분석합니다.
# 기본 모델/프롬프트/영상 처리/작업자는 서버가 준비하므로 아래 키만 필요합니다.
# 모델 접근 권한과 API 결제/잔액이 있는 키를 사용하고 입력 후 서버를 재시작하세요.
OPENAI_API_KEY=
